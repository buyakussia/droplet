<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.droplet" path="/org/gnome/shell/extensions/droplet/">
    <key name="widgets" type="as">
      <default>['media', 'calendar', 'audio', 'shelf', 'clipboard', 'notes', 'pomodoro', 'system']</default>
      <summary>Включённые виджеты в порядке показа</summary>
    </key>
    <key name="transparent-panel" type="b">
      <default>true</default>
      <summary>Прозрачная верхняя панель (непрозрачная, когда окно касается её)</summary>
    </key>
    <key name="shape" type="s">
      <choices><choice value="island"/><choice value="notch"/></choices>
      <default>'island'</default>
      <summary>Форма капли: island — парит, как Dynamic Island; notch — прилегает к краю, как вырез</summary>
    </key>
    <key name="active-tab" type="s">
      <default>'media'</default>
      <summary>Последняя открытая вкладка</summary>
    </key>
    <key name="hud" type="b">
      <default>true</default>
      <summary>Громкость и яркость в капле вместо окошка GNOME</summary>
    </key>
    <key name="notes" type="s">
      <default>''</default>
      <summary>Текст заметок</summary>
    </key>
    <key name="pomodoro-focus" type="i">
      <range min="1" max="180"/>
      <default>25</default>
      <summary>Фокус, минут</summary>
    </key>
    <key name="pomodoro-break" type="i">
      <range min="1" max="60"/>
      <default>5</default>
      <summary>Перерыв, минут</summary>
    </key>
    <key name="pomodoro-long" type="i">
      <range min="1" max="90"/>
      <default>15</default>
      <summary>Длинный перерыв, минут</summary>
    </key>
    <key name="pomodoro-every" type="i">
      <range min="2" max="10"/>
      <default>4</default>
      <summary>Длинный перерыв после стольких фокусов</summary>
    </key>
    <key name="expand-on-hover" type="b">
      <default>false</default>
      <summary>Раскрывать каплю при наведении курсора</summary>
    </key>
    <key name="show-notifications" type="b">
      <default>true</default>
      <summary>Показывать уведомления в капле</summary>
    </key>
    <key name="replace-banners" type="b">
      <default>true</default>
      <summary>Не показывать стандартный баннер GNOME для уведомлений, показанных в капле</summary>
    </key>
    <key name="show-battery" type="b">
      <default>true</default>
      <summary>Показывать события батареи</summary>
    </key>
    <key name="media-activity" type="b">
      <default>true</default>
      <summary>Коротко показывать новый трек</summary>
    </key>
    <key name="shelf-files" type="as">
      <default>[]</default>
      <summary>Файлы на полке (URI)</summary>
    </key>
    <key name="shelf-limit" type="i">
      <range min="1" max="50"/>
      <default>12</default>
      <summary>Сколько файлов держать на полке</summary>
    </key>
  </schema>
</schemalist>
